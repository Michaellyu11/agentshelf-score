# AgentShelf Environment Variables
# Copy to .env and fill in your values

# AI APIs
ANTHROPIC_API_KEY=sk-ant-your-key-here
DEEPSEEK_API_KEY=sk-your-key-here
OPENAI_API_KEY=sk-your-key-here
PERPLEXITY_API_KEY=pplx-your-key-here
GEMINI_API_KEY=your-key-here
FIRECRAWL_API_KEY=fc-your-key-here

# Auth
JWT_SECRET=change-me-use-openssl-rand-hex-32

# Email (Resend)
RESEND_API_KEY=re_your-key-here
EMAIL_FROM=AgentShelf <noreply@agentshelf.co>
FRONTEND_URL=https://agentshelf.co

# Payments (Polar)
POLAR_ACCESS_TOKEN=polar_pat_your-token-here
POLAR_WEBHOOK_SECRET=whsec_your-secret-here
POLAR_PRODUCT_PRO=582a3ec5-800c-4780-9368-c22980ff2690
POLAR_PRODUCT_GROWTH=84f9fad2-4afd-438f-8abb-5b7d16c458e1

# Database (Railway: set to /data/agentshelf.db with Volume mount)
SQLITE_PATH=./agentshelf.db

# Misc
DEBUG=true
